from transformers import DistilBertForSequenceClassification, DistilBertTokenizer
import torch
import torch.nn.functional as F

# 1. Chargement du modèle 
model_path = "./models/distilbert_jigsaw_final"
print("--- Chargement du modèle pour inférence ---")

loaded_model = DistilBertForSequenceClassification.from_pretrained(model_path)
loaded_tokenizer = DistilBertTokenizer.from_pretrained(model_path)

# Configuration pour l'évaluation
loaded_model.to("cpu")
loaded_model.eval()

# 2. Fonction de prédiction
def predict_toxicity(text):
    # Max length 64 pour coller à l'entraînement)
    inputs = loaded_tokenizer(text, return_tensors="pt", truncation=True, padding="max_length", max_length=64)
    
    with torch.no_grad():
        outputs = loaded_model(**inputs)
    
    logits = outputs.logits
    probs = F.softmax(logits, dim=1)
    
    # Récupération de la probabilité de toxicité
    toxic_score = probs[0][1].item()
    
    prediction = "TOXIQUE" if toxic_score >= 0.5 else "NON TOXIQUE"
    return prediction, toxic_score








