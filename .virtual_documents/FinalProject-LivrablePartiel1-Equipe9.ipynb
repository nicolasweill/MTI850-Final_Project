def preprocessing_static_pipeline(train, limit: int=None, debug=False):
    """
    Exécute les étapes de prétraitement Spark lourdes et statiques (nettoyage, features, W2V).
    Ces étapes ne dépendent pas des hyperparamètres de pondération/d'équilibrage.

    Args:
        train (DataFrame): Le DataFrame d'entrée initial (non traité).
        limit (int): Limite facultative du nombre de lignes pour le prétraitement.
        debug (bool): Active le mode débogage pour la fonction preprocess.

    Returns:
        tuple[DataFrame, DataFrame]: (df_train_final_all_w2v mis en cache, df_test_final_all_w2v mis en cache)
    """
    import pyspark.sql.functions as F # Importation locale pour la fonction
    
    print(">>> Démarrage du pré-traitement statique...")
    
    # 1. PRÉTRAITEMENT INITIAL
    df_tronq_all, df_preprocess_comments = preprocess(train, limit=limit, debug=debug)
    df_clean_final = df_preprocess_comments

    # 2. SPLIT
    seed_split = 42
    # Utilisation d'une seed différente du split de l'Outer CV pour garantir l'indépendance
    train_df_all, test_df_all = df_clean_final.randomSplit([0.9, 0.1], seed=seed_split) 
    print("\n>>> Split OK (via randomSplit)")
    print(f"Train = {train_df_all.count()} | Test = {test_df_all.count()}")

    # 3. FEATURE ENGINEERING ET W2V
    train_df_all_bigrams = add_bigrams(train_df_all)
    test_df_all_bigrams = add_bigrams(test_df_all)

    df_train_all_feat_eng = extract_text_features(train_df_all_bigrams)
    df_test_all_feat_eng = extract_text_features(test_df_all_bigrams)

    # Note: w2v_model doit être un modèle entraîné disponible globalement
    df_train_final_all_w2v = w2v_model.transform(df_train_all_feat_eng)
    df_test_final_all_w2v = w2v_model.transform(df_test_all_feat_eng)

    # Déclenchement de l'action de cache (via count)
    print(f"Base d'entraînement en cache : {df_train_final_all_w2v.count()} lignes")
    print(f"Base de test en cache : {df_test_final_all_w2v.count()} lignes")

    # 4. MISE EN CACHE
    df_train_final_all_w2v.cache()
    df_test_final_all_w2v.cache()
    
    return df_train_final_all_w2v, df_test_final_all_w2v

