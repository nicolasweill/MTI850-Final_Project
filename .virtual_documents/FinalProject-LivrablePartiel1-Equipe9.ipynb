import torch
import numpy as np
import pandas as pd
from datasets import load_from_disk
from transformers import DistilBertForSequenceClassification, Trainer, TrainingArguments
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import seaborn as sns
import matplotlib.pyplot as plt

# --- CONFIGURATION ---
DATASET_PATH = "./jigsaw-unintended-bias-in-toxicity-classification/data/Bert/processed_data_bert_10k_ratio6"
MODEL_PATH = "./models/distilbert_jigsaw_final"

print("--- Chargement des données et du modèle ---")

# Chargement du dataset
dataset = load_from_disk(DATASET_PATH)
test_dataset = dataset["test"] # partie Test

# Chargement du modèle
model = DistilBertForSequenceClassification.from_pretrained(MODEL_PATH)

# Création d'un Trainer pour la prédiction 
training_args = TrainingArguments(
    output_dir="./results_inference",
    per_device_eval_batch_size=64,
    do_train=False,
    do_predict=True,
    use_cpu=True # Configuration pour la VM via virtual Box pour éviter les erreurs avec le GPU
)

trainer = Trainer(
    model=model,
    args=training_args
)

print(f"Nombre d'échantillons de test : {len(test_dataset)}")


print("--- Lancement des prédictions sur le jeu de test ---")
# Étape longue
predictions_output = trainer.predict(test_dataset)

# Récupération des logits
logits = predictions_output.predictions

y_preds = np.argmax(logits, axis=1)

# Récupération des labels
y_true = predictions_output.label_ids

print("--- Prédictions terminées ---")








